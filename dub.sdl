name "dub-publish"
description "CLI to register Git repositories with the DUB package registry (code.dlang.org)"
authors "amdphreak"
copyright "Copyright © 2026, amdphreak"
license "BSL-1.0"
# Version comes from git tags (vX.Y.Z) / VERSION file for --version.

targetType "executable"
targetName "dub-publish"

versions "DubPublishCli"

# prohelp comes from code.dlang.org. For local co-development use dub add-local
# (see README "Testing against a local prohelp"); never a path dependency here.
dependency "prohelp" version="~>0.2.3"
dependency "sdlang-d" version="~>0.10.6"

importPaths "source"
sourcePaths "source"
stringImportPaths "."

libs "user32" platform="windows"
